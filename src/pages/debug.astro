---
import client from '../lib/sitecore-client';

let pageName: string | undefined;
let siteName: string | undefined;
let placeholderKeys: string[] = [];
let error: string | null = null;

try {
  const page = await client.getPage('/', { site: 'sync', locale: 'en' });
  pageName = page?.layout?.sitecore?.route?.name;
  siteName = page?.layout?.sitecore?.context?.site?.name;
  placeholderKeys = Object.keys(page?.layout?.sitecore?.route?.placeholders ?? {});
} catch (e) {
  error = e instanceof Error ? e.message : String(e);
}
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Astro × Sitecore — smoke test</title>
  </head>
  <body>
    <h1>Astro × Sitecore</h1>
    {error ? (
      <pre style="color: crimson">{error}</pre>
    ) : (
      <ul>
        <li>Route: <code>{pageName}</code></li>
        <li>Site: <code>{siteName}</code></li>
        <li>Placeholders: <code>{placeholderKeys.join(', ') || '(none)'}</code></li>
      </ul>
    )}
  </body>
</html>
