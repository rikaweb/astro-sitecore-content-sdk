---
import { getContentSdkPagesClientData } from '@sitecore-content-sdk/core/editing';

interface Props {
  context?: {
    clientScripts?: string[];
    clientData?: Record<string, unknown>;
  };
}

const { context } = Astro.props;

const clientScripts = context?.clientScripts ?? [];
const clientData: Record<string, unknown> = {
  ...(context?.clientData ?? {}),
  ...getContentSdkPagesClientData(),
};
---

{clientScripts.map((src) => <script src={src} is:inline></script>)}

{Object.entries(clientData).map(([id, data]) => (
  <script id={id} type="application/json" is:inline set:html={JSON.stringify(data).replace(/</g, '\\u003c')}></script>
))}
