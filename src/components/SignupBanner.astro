---
interface Field<T> { value: T }

interface Props {
  fields?: {
    Title?: Field<string>;
    Subtitle?: Field<string>;
  };
  params?: Record<string, string | undefined>;
}

const { fields } = Astro.props;
const title = fields?.Title?.value;
const subtitle = fields?.Subtitle?.value;
const buttonLabel = 'Sign me up';
---

{!fields ? (
  <section class="py-16 bg-neutral-900 text-center">
    <p class="text-neutral-500 text-lg">SignupBanner — No content available</p>
  </section>
) : (
  <section class="relative py-16 md:py-24 bg-neutral-900 overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-br from-neutral-900 via-neutral-800 to-neutral-900" />
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[800px] h-[400px] bg-lime-400/10 rounded-full blur-3xl" />

    <div class="relative z-10 max-w-2xl mx-auto px-8 text-center">
      {title && (
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-white mb-4">{title}</h2>
      )}

      {subtitle && (
        <p class="text-neutral-400 text-lg mb-8">{subtitle}</p>
      )}

      <form class="flex flex-col sm:flex-row items-center justify-center gap-4 max-w-md mx-auto">
        <input
          type="email"
          placeholder="Enter your email"
          class="w-full sm:flex-1 h-12 px-5 rounded-full bg-neutral-800 border border-neutral-700 text-white placeholder-neutral-500 focus:outline-none focus:border-lime-400"
        />
        <button
          type="submit"
          class="h-12 px-8 text-sm font-semibold rounded-full bg-lime-400 text-neutral-900 hover:bg-lime-300 border-0 shadow-lg shadow-lime-400/30 whitespace-nowrap cursor-pointer"
        >
          {buttonLabel}
        </button>
      </form>

      <p class="mt-6 text-xs text-neutral-600">
        Button label hardcoded in Astro
        <span class="text-neutral-500"> · </span>
        Page Router uses
        <code class="text-lime-400/70 ml-1">next-localization useI18n()</code>
      </p>
    </div>
  </section>
)}
