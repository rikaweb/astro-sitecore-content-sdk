---
interface Props {
  name: string;
}
const { name } = Astro.props;
---

<div style="padding:24px;margin:16px;border:2px dashed #d4d4d4;background:#fafafa;color:#737373;font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:14px">
  <strong>[Missing component]</strong> {name} — not yet implemented in Astro
</div>
